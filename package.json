{
  "name": "ts-xpra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test --experimental-test-isolation=none tests/*.test.ts",
    "test:browser": "node --experimental-strip-types --test --experimental-test-isolation=none tests/browser/*.test.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "lz4js": "0.2.0"
  },
  "devDependencies": {
    "@types/node": "24.12.2",
    "typescript": "5.9.3",
    "vite": "6.4.1",
    "ws": "8.22.0",
    "@types/ws": "8.18.1",
    "puppeteer-core": "25.12.0"
  },
  "overrides": {
    "esbuild": "0.25.12",
    "rollup": "4.59.0"
  }
}
